{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "src",
        "allowImportingTsExtensions": false,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "outDir": "dist"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
    "exclude": ["src/spec/**", "dist", "node_modules"]
}

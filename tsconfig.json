{
    "extends": "@tsconfig/strictest/tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "target": "ESNext",
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "storybook-solidjs-vite/renderer/solid-legacy": [
                "./src/renderer/solid-legacy.ts"
            ],
            "storybook-solidjs-vite/renderer/solid-next": [
                "./src/renderer/solid-next.ts"
            ]
        },
        "jsx": "preserve",
        "jsxImportSource": "solid-js",


        "lib": ["ESNext", "DOM"],
        "moduleDetection": "force",
        "rootDir": ".",
        "module": "ESNext",

        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "noEmit": true,
        "sourceMap": true,
        "isolatedModules": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.d.ts",
        "tsdown.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["dist", "node_modules", "src/spec/packageExports/consumer.ts"]
}
